---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
// The changelog lives at the repo root so it ships with the code.
import { compiledContent, getHeadings } from '../../../CHANGELOG.md';

// The file's own "# Changelog" heading is the page title here.
const headings = getHeadings().filter((h) => h.depth > 1);
const html = (await compiledContent()).replace(/<h1[^>]*>.*?<\/h1>/s, '');
---

<StarlightPage frontmatter={{ title: 'Changelog', description: 'What’s new in each Kass release.' }} headings={headings}>
	<Fragment set:html={html} />
</StarlightPage>
