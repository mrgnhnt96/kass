---
// Looping illustration of one dictation: hold the chord, speak, let go, and
// clean text lands in the app. Words marked with ~ are dropped by cleanup.
const takes = [
  {
    app: 'Messages',
    to: 'To: Sam',
    style: 'Casual',
    said: '~um ~so I think we should ~uh meet at ~three, ~no ~actually four at the coffee place',
    clean: 'I think we should meet at four at the coffee place',
  },
  {
    app: 'Mail',
    to: 'To: Jordan · Re: launch',
    style: 'Professional',
    said: 'hey Jordan quick update the build is green ~and ~uh ~yeah I will ship it tomorrow morning unless you ~like want another pass',
    clean:
      'Hey Jordan, quick update: the build is green. I will ship it tomorrow morning unless you want another pass.',
  },
  {
    app: 'Notes',
    to: 'Weekend',
    style: 'Personal',
    said: 'make a list of eggs, oat milk, ~uh ~the ~um coffee beans and basil',
    clean: '- Eggs\n- Oat milk\n- Coffee beans\n- Basil',
  },
];
---

<div class="demo" data-takes={JSON.stringify(takes)} aria-label="Animated illustration of Kass turning speech into clean text" role="img">
	<div class="window">
		<div class="titlebar">
			<span class="dots"><i></i><i></i><i></i></span>
			<span class="app-name" data-app>Messages</span>
			<span class="chip" data-style>Casual</span>
		</div>
		<div class="to" data-to>To: Sam</div>
		<div class="field">
			<span class="out" data-out>{takes[0].clean}</span><span class="caret"></span>
		</div>
	</div>

	<div class="said">
		<span class="said-label">You said</span>
		<p class="said-text" data-said>{takes[0].said.replaceAll('~', '')}</p>
	</div>

	<div class="controls">
		<div class="keys" data-keys>
			<span class="key">right ⌘</span>
			<span class="plus">+</span>
			<span class="key">right ⌥</span>
		</div>
		<div class="pill" data-pill>
			<span class="bars" aria-hidden="true">
				<i></i><i></i><i></i><i></i><i></i><i></i><i></i>
			</span>
			<span class="pill-label" data-pill-label>Listening</span>
		</div>
	</div>

	<p class="note">Illustration. The real app is below.</p>
</div>

<style>
	.demo {
		position: relative;
		width: 100%;
		max-width: 520px;
		margin-left: auto;
	}

	.note {
		margin-top: 14px;
		font-size: 0.85rem;
		color: var(--ink-faint);
		text-align: center;
	}

	.window {
		background: linear-gradient(180deg, #1d1f24, #15171b);
		border: 1px solid var(--line-strong);
		border-radius: 16px;
		box-shadow:
			0 40px 80px -30px rgba(0, 0, 0, 0.8),
			0 0 0 1px rgba(255, 255, 255, 0.02) inset;
		overflow: hidden;
	}

	.titlebar {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px 14px;
		border-bottom: 1px solid var(--line);
		font-size: 0.82rem;
		color: var(--ink-soft);
	}

	.dots {
		display: inline-flex;
		gap: 6px;
	}

	.dots i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #363a42;
	}

	.app-name {
		font-weight: 600;
		color: var(--ink);
	}

	.chip {
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		padding: 3px 9px;
		border-radius: 999px;
		border: 1px solid var(--green-deep);
		color: var(--green);
		background: var(--green-glow);
	}

	.to {
		padding: 10px 16px;
		font-size: 0.82rem;
		color: var(--ink-faint);
		border-bottom: 1px solid var(--line);
	}

	.field {
		padding: 18px 16px 22px;
		min-height: 150px;
		font-size: 1.02rem;
		line-height: 1.55;
		white-space: pre-wrap;
		color: var(--ink);
	}

	.out {
		transition: opacity 0.3s ease;
	}

	.caret {
		display: inline-block;
		width: 2px;
		height: 1.15em;
		margin-left: 1px;
		vertical-align: text-bottom;
		background: var(--green);
		animation: blink 1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.said {
		margin: 18px 6px 0;
		min-height: 4.6em;
	}

	.said-label {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--ink-faint);
	}

	.said-text {
		margin-top: 4px;
		color: var(--ink-soft);
		font-size: 0.95rem;
		font-style: italic;
	}

	.said-text :global(span) {
		opacity: 0;
		transition:
			opacity 0.2s ease,
			color 0.3s ease;
	}

	.said-text :global(span.on) {
		opacity: 1;
	}

	.said-text :global(span.drop.struck) {
		color: var(--strike);
		text-decoration: line-through;
		text-decoration-thickness: 2px;
	}

	.controls {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin: 14px 6px 0;
		flex-wrap: wrap;
	}

	.keys {
		display: flex;
		align-items: center;
		gap: 8px;
		color: var(--ink-faint);
	}

	.keys .key {
		transition:
			transform 0.12s ease,
			border-color 0.12s ease,
			color 0.12s ease,
			box-shadow 0.12s ease;
	}

	.keys.down .key {
		transform: translateY(2px);
		border-bottom-width: 1px;
		border-color: var(--green);
		color: var(--green-bright);
		box-shadow: 0 0 18px var(--green-glow);
	}

	.pill {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 8px 14px;
		border-radius: 999px;
		background: #0a0b0d;
		border: 1px solid var(--line-strong);
		opacity: 0;
		transform: translateY(6px) scale(0.96);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}

	.pill.show {
		opacity: 1;
		transform: none;
	}

	.pill-label {
		font-size: 0.78rem;
		color: var(--ink-soft);
		min-width: 6.5em;
	}

	.bars {
		display: inline-flex;
		align-items: center;
		gap: 3px;
		height: 18px;
	}

	.bars i {
		width: 3px;
		height: 4px;
		border-radius: 2px;
		background: var(--green);
	}

	.pill.rec .bars i {
		animation: level 0.9s ease-in-out infinite;
	}

	.bars i:nth-child(2) {
		animation-delay: -0.2s !important;
	}
	.bars i:nth-child(3) {
		animation-delay: -0.5s !important;
	}
	.bars i:nth-child(4) {
		animation-delay: -0.1s !important;
	}
	.bars i:nth-child(5) {
		animation-delay: -0.7s !important;
	}
	.bars i:nth-child(6) {
		animation-delay: -0.35s !important;
	}
	.bars i:nth-child(7) {
		animation-delay: -0.6s !important;
	}

	@keyframes level {
		0%,
		100% {
			height: 4px;
		}
		50% {
			height: 17px;
		}
	}

	.pill.busy .bars i {
		animation: shimmer 1.1s ease-in-out infinite;
		height: 4px;
	}

	@keyframes shimmer {
		0%,
		100% {
			opacity: 0.25;
		}
		50% {
			opacity: 1;
		}
	}
</style>

<script>
	type Take = { app: string; to: string; style: string; said: string; clean: string };

	const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	for (const demo of document.querySelectorAll<HTMLElement>('.demo')) {
		const takes: Take[] = JSON.parse(demo.dataset.takes ?? '[]');
		const $ = (name: string) => demo.querySelector<HTMLElement>(`[data-${name}]`)!;
		const [app, to, style, out, said, keys, pill, pillLabel] = [
			'app', 'to', 'style', 'out', 'said', 'keys', 'pill', 'pill-label',
		].map($);

		const show = (take: Take) => {
			app.textContent = take.app;
			to.textContent = take.to;
			style.textContent = take.style;
		};

		const words = (take: Take) =>
			take.said.split(' ').map((raw) => {
				const span = document.createElement('span');
				const drop = raw.startsWith('~');
				span.textContent = (drop ? raw.slice(1) : raw) + ' ';
				if (drop) span.classList.add('drop');
				return span;
			});

		if (reduced) {
			const take = takes[0];
			show(take);
			said.replaceChildren(...words(take).map((s) => (s.classList.add('on', 'struck'), s)));
			out.textContent = take.clean;
			continue;
		}

		(async () => {
			for (let i = 0; ; i = (i + 1) % takes.length) {
				const take = takes[i];
				show(take);
				out.textContent = '';
				const spans = words(take);
				said.replaceChildren(...spans);
				await sleep(700);

				keys.classList.add('down');
				pill.classList.add('show', 'rec');
				pillLabel.textContent = 'Listening';
				await sleep(300);
				for (const span of spans) {
					span.classList.add('on');
					await sleep(170);
				}
				await sleep(350);

				keys.classList.remove('down');
				pill.classList.replace('rec', 'busy');
				pillLabel.textContent = 'Cleaning up';
				for (const span of spans.filter((s) => s.classList.contains('drop'))) {
					span.classList.add('struck');
					await sleep(90);
				}
				await sleep(450);

				pill.classList.remove('show', 'busy');
				out.style.opacity = '0';
				out.textContent = take.clean;
				await sleep(30);
				out.style.opacity = '1';
				await sleep(3600);
			}
		})();
	}
</script>
