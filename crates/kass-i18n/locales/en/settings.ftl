settings-captures-storage-retention-confirm-title = Keep { $window } of history?
settings-captures-storage-retention-confirm-description =
    { $count ->
        [one] { $count } capture older than { $window } will be deleted with its audio. Its corrections, what Kass learned from it and your stats are kept.
       *[other] { $count } captures older than { $window } will be deleted with their audio. Their corrections, what Kass learned from them and your stats are kept.
    }
settings-captures-storage-retention-confirm-unknown = Captures older than { $window } will be deleted with their audio. Their corrections, what Kass learned from them and your stats are kept.
settings-captures-storage-retention-confirm-delete =
    { $count ->
        [one] Delete { $count } capture
       *[other] Delete { $count } captures
    }
settings-captures-storage-retention-confirm-delete-unknown = Delete older captures
settings-captures-storage-retention-ask-title = Delete old captures?
settings-captures-storage-retention-ask-description =
    { $count ->
        [0] Kass now keeps { $window } of history. No captures are older than that yet. Your corrections, the names they taught and your stats are always kept.
        [one] Kass now keeps { $window } of history. { $count } capture is older than that and would be deleted with its audio. Your corrections, the names it learned and your stats are kept.
       *[other] Kass now keeps { $window } of history. { $count } captures are older than that and would be deleted with their audio. Your corrections, the names they taught and your stats are kept.
    }
settings-captures-storage-retention-ask-choose = Keep history for
settings-captures-storage-retention-ask-counting = Counting…
settings-captures-storage-retention-ask-later = Not now
settings-captures-storage-retention-ask-forever = Keep forever
settings-captures-storage-retention-ask-keep =
    { $count ->
        [0] Keep { $window }
        [one] Keep { $window }, delete { $count }
       *[other] Keep { $window }, delete { $count }
    }
